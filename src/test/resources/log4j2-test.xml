<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
    <!-- Minecraft's default file appender would overwrite uploaded logs/latest.log. -->
    <Appenders><Console name="Console" target="SYSTEM_OUT"><PatternLayout pattern="[%t/%level] %msg%n%throwable"/></Console></Appenders>
    <Loggers><Root level="WARN"><AppenderRef ref="Console"/></Root></Loggers>
</Configuration>
